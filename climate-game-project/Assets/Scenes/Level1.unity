  m_Script: {fileID: 11500000, guid: 0afc319f54654d645ac472b3d5386321, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::TypewriterImageClue
  clueText: "\u201CBreaking News: IEA (International Energy Agency) has just released
    their Net Zero roadmap for 2025, calling for a total ban of new oil, coal and
    gas development from 2021. This came as a surprise for many, as IAE previously
    had been very cautious in favor of fossil companies, which now leaves investors
    and stakeholders in said companies without backup for their actions. How will
    they stay afloat?\u201D"
  textDisplay: {fileID: 1927334781}
  typingSpeed: 60
