--- !u!114 &1649098851
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1649098849}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: f4688fdb7df04437aeb418b961361dc5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Unity.TextMeshPro::TMPro.TextMeshProUGUI
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "This game was created by \nLinn Christiansen and Alva H\xF6glund \nduring
    our internship at Svenska H\xE5llbarhetsfonden. \n\nThis game is an educational
    visualization of the book \nWhere the Moneytree Grows: Invest Climate-Smart and
    Get Rich \nwritten by Sasja Beslijk and Karim Sayyad. The purpose of this experience
    is to better understand how financial decisions have long term effects on the
    climate.\r\n\r\nSasja Beslijk alongside Joakim Friis acted as our mentors during
    this project and we want to especially thank their patience and expertise on
    the area. It has led us in the right direction during development and helped
    us produce our first published title as a developer duo. \n\nFor the best experience
    with the game, read the book first and treat this game as a test to see if you
    have grasped the importance of environmentally mindful decisions.\r\n\r\nBGM:
    Just a Taste by JMHBM,\nfound on Freemusicarchive, published under CC BY license\r\n\r\nSound
    effects from ZapSplat\r\n"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 9b7528e0c1226974991d1ed873a501db, type: 2}
  m_sharedMaterial: {fileID: 4418553693185215687, guid: 9b7528e0c1226974991d1ed873a501db, type: 2}
