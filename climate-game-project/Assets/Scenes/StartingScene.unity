  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "Swedes have on average $57,000 saved in stocks. When deciding where you
    want your investments to be, a multitude of factors play into the choice. Do
    you go with the safest option, which yields a lower return? Or do you gamble,
    with high risk and high reward? Is increasing your returns the highest priority,
    or is there another angle to consider? In this game, you will be faced with situations
    that\u2019s meant for you to question your choices, and visualize that actions
    do have consequences; both immediate, but also long term.\r\n"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
  m_sharedMaterial: {fileID: 2180264, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
